  <Indicator _name="terminals" conIdx="3" connection="recommended" type="int32" uid="40" uid_parent="root" value="0" inputs="value:32.n"/>
  <Indicator _name="terminal errors" type="array{cluster{bool.status,int32.code,string.source}}" uid="41" uid_parent="root" value="[]" inputs="value:25.errs"/>
  <Indicator _name="error out" conIdx="2" connection="recommended" type="cluster{bool.status,int32.code,string.source}" uid="42" uid_parent="root" value="[false,0,]" inputs="value:31.err"/>
</VI>
