submodules/builds
venv
*.aliases
Session.vim

# --- Vivado (vivado/): generated project dir, exported hardware, logs ---
# The BD/project is regenerated from vivado/mktdata_poc.tcl (+ build.tcl), the
# XSA from `make xsa`. Tracked sources (vivado/*.tcl, vivado/ip/*,
# vivado/constraints.xdc, vivado/Makefile) are NOT matched here.
vivado/mktdata_poc/
vivado/*.xsa
vivado/*.log
vivado/*.jou
.Xil/

# --- Vitis Classic: disposable workspaces (apps/*/build.tcl regenerates them) ---
vitis_ws/

# --- Cross-compiled / native test binaries (regenerated by make / gcc) ---
apps/mktdata_poc_test/mktdata_poc_test
apps/mktdata_poc_test/fifoexp
apps/mktdata_poc_test/fifo16
apps/poc_server/poc_server

# Local research notes, never committed
leads.txt

# apps/poc_inject: cross-compiled binary + python cache
apps/poc_inject/poc_inject
apps/poc_inject/__pycache__/
# ip_export/netlist_sim: xsim build products and run outputs (regenerate with run.sh / gen_frames.py)
ip_export/netlist_sim/xsim.dir/
ip_export/netlist_sim/*.log
ip_export/netlist_sim/*.jou
ip_export/netlist_sim/*.pb
ip_export/netlist_sim/sim_*.txt
ip_export/netlist_sim/frames*.txt
scripts/__pycache__/

# --- 2026-11-08: detached-build stdout, cross-compiled board tools ---
vivado/*.out
apps/poc_inject/xxv_stats
apps/poc_inject/poc_mon

# --- vivado_rtl (pure-RTL bitstream): generated project, XSA, logs, xsim products ---
vivado_rtl/mktdata_rtl/
vivado_rtl/*.xsa
vivado_rtl/*.log
vivado_rtl/*.jou
vivado_rtl/*.out
vivado_rtl/sim/xsim.dir/
vivado_rtl/sim/*.log
vivado_rtl/sim/*.jou
vivado_rtl/sim/*.pb
vivado_rtl/sim/*.wdb
vivado_rtl/sim/beats.txt
vivado_rtl/sim/sim_out.txt
vivado/build.pid
vivado_rtl/build.pid
