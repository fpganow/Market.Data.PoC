# --- Vivado (vivado/): generated project dir, exported hardware, logs ---
# The BD/project is regenerated from vivado/mktdata_poc.tcl (+ build.tcl), the
# XSA from `make xsa`. Tracked sources (vivado/*.tcl, vivado/ip/*,
# vivado/constraints.xdc, vivado/Makefile) are NOT matched here.
vivado/mktdata_poc/
vivado/*.xsa
vivado/*.log
vivado/*.jou
.Xil/

# --- Vitis Classic: disposable workspaces (apps/*/build.tcl regenerates them) ---
vitis_ws/

# --- Cross-compiled / native test binaries (regenerated by make / gcc) ---
apps/mktdata_poc_test/mktdata_poc_test
apps/mktdata_poc_test/fifoexp
apps/mktdata_poc_test/fifo16
