@startuml avl_tree
hide empty description

title AVL Tree

label InsertOrder[
{{
    hide empty description
        <style> 
    stateDiagram {
        LineColor Black
        LineThickness 3.0
    }
    </style>
    'skinparam sequenceArrowThickness 3.0

    [*] --> 12
      12 --> 8
      12 --> 18
      8 --> 5
      8 --> 11
      18 --> 17
      5 --> 4

    A -right-> B
    B -right-> C

